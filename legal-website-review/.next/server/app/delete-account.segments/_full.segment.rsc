c:["$","p",null,{"children":"This draft cannot yet accept an outside-app deletion request. A monitored mailbox and verified manual process are required before publication or use as the Play Console deletion URL."}]
d:["$","section","in-app",{"id":"in-app","className":"reserved-section","children":[["$","h2",null,{"children":"Delete Your Account in the App"}],[["$","p",null,{"children":"You can request permanent deletion of your Cubyfit account and supported associated personal records. This action cannot be undone."}],["$","ol",null,{"children":[["$","li",null,{"children":"Sign in to Cubyfit."}],["$","li",null,{"children":["Go to ",["$","strong",null,{"children":"Account → Data & Privacy → Delete Account"}],"."]}],["$","li",null,{"children":["Read the warning and enter ",["$","code",null,{"children":"DELETE-ACCOUNT"}],"."]}],["$","li",null,{"children":"Complete Clerk identity reverification with the required email code."}],["$","li",null,{"children":"Submit the deletion request."}]]}],["$","p",null,{"children":"The app displays available progress information while the deletion service works. Completion may take time or require retries."}]]]}]
e:["$","section","outside",{"id":"outside","className":"reserved-section","children":[["$","h2",null,{"children":"Cannot Access Your Account?"}],[["$","p",null,{"children":["An outside-app request channel is being established. ",["$","strong",null,{"children":"[VERIFIED ACCOUNT DELETION EMAIL PENDING]"}]," must be a monitored, working address before this page can be published as an external request pathway."]}],["$","p",null,{"children":["When available, email that address with the subject ",["$","strong",null,{"children":"Cubyfit Account Deletion Request"}],", identify the email associated with your Cubyfit account, and clearly request permanent deletion. We may require secure proof of ownership. Never email a password, authentication code or session token. You should not need to reinstall the app to initiate an outside-app request."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Before publication:"}]," Assign an owner, implement a secure authorized manual workflow, and verify the mailbox and a seven-calendar-day acknowledgement target. No response time is promised by this unpublished draft."]}]]]}]
f:["$","section","deleted",{"id":"deleted","className":"reserved-section","children":[["$","h2",null,{"children":"What the Process Deletes"}],[["$","p",null,{"children":"The verified deletion job removes supported account-owned active Convex records: profile; habits and historical completions; missions and completions; custom exercises; routines; workouts, nested exercises and sets; weights; measurements; rest days; favorites; preferences; and synchronization records and operations. These cover supported cloud-backed fitness, nutrition and account-linked progress records."}],["$","p",null,{"children":"The job then requests deletion of the matching RevenueCat customer and Clerk identity. If a customer has another nonanonymous alias, processing pauses for review instead of deleting an ambiguous customer. The device that observes completion removes the matching account-specific SQLite file and reminders."}],["$","p",null,{"children":"Cubyfit does not intend to retain identifiable fitness statistics solely for business analytics after account deletion. No separate account-linked business-analytics warehouse was identified in the reviewed source."}]]]}]
10:["$","section","remaining",{"id":"remaining","className":"reserved-section","children":[["$","h2",null,{"children":"What May Remain"}],[["$","ul",null,{"children":[["$","li",null,{"children":"A limited technical deletion-status record for about 30 days after completion; incomplete jobs remain for retries and review."}],["$","li",null,{"children":"Account data on disconnected devices until they reconnect and process completion. If the status record has expired by then, manual app-data clearing may be needed."}],["$","li",null,{"children":"Operating-system and provider backups under separate schedules."}],["$","li",null,{"children":"Store billing and transaction records, and provider-held security, diagnostic, advertising or infrastructure records under their applicable policies and obligations."}],["$","li",null,{"children":"Guest data and shared downloaded catalog files, which are separate from authenticated account records."}]]}],["$","p",null,{"children":"The current job has no direct purge for Sentry events, AdMob records, Cloudflare gateway state or app-store transactions. We cannot promise immediate erasure from every system."}]]]}]
11:["$","section","subscription",{"id":"subscription","className":"reserved-section","children":[["$","h2",null,{"children":"Cancel Your Subscription Separately"}],["$","p",null,{"children":["Account deletion does not automatically cancel billing. To stop future renewals, manage the subscription with ",["$","a",null,{"href":"https://play.google.com/store/account/subscriptions","children":"Google Play"}]," or ",["$","a",null,{"href":"https://apps.apple.com/account/subscriptions","children":"Apple"}],"."]}]]}]
