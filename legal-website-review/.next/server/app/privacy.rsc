11:["$","article",null,{"className":"legal-document legal-draft","children":[["$","div",null,{"className":"legal-meta","children":[["$","span",null,{"children":"Draft: November 18, 2026"}],["$","span",null,{"children":"Pending final verification"}]]}],["$","div",null,{"className":"placeholder-notice","children":[["$","h2",null,{"children":"Publication draft"}],["$","p",null,{"children":"This policy is not finalized. Contact, legal bases, age treatment, international transfers and provider retention remain under review. Do not publish it as the operative Privacy Policy."}]]}],[["$","section","scope",{"id":"scope","className":"reserved-section","children":[["$","h2",null,{"children":"About this draft"}],[["$","p",null,{"children":"Cubyfit is a fitness, nutrition, habit-tracking and personal-growth application developed and operated by Mohamed Radouan, Marouan Younsi and Mouad Mezian in Casablanca, Morocco (“Cubyfit,” “we,” or “us”). This draft explains what information we process, why we use it, who provides supporting services, and how users can manage or request deletion of their information."}],["$","p",null,{"children":["Privacy contact: ",["$","strong",null,{"children":"[VERIFIED PRIVACY EMAIL PENDING]"}],". A postal contact address and the final legal controller description must be confirmed before publication."]}]]]}],["$","section","information",{"id":"information","className":"reserved-section","children":[["$","h2",null,{"children":"1. Information We Process"}],[["$","p",null,{"children":[["$","strong",null,{"children":"Account:"}]," Name, email, account identifier, sign-in method, verification and recovery information, and information from Google or Apple if you choose social sign-in. Clerk provides authentication; Cubyfit does not maintain a separate password database."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Fitness and growth:"}]," Information you enter or generate through the features you use, including date of birth, height, weight, target weight, fitness goals, activity and experience, workouts, routines, measurements, habits, schedules, completions, streaks, nutrition targets, meals, saved foods, preferences, reminders and favorites. Some of this may be sensitive under applicable law."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Purchases:"}]," Account and product identifiers, entitlement and subscription status through RevenueCat and the applicable store. Payments are handled by Google Play or Apple's App Store, not by direct entry of payment-card details in Cubyfit."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Technical data:"}]," Depending on platform and settings, service providers may process device and operating-system details, app version, diagnostics, performance, IP address, service identifiers, advertising identifiers and ad events. Website hosting and support requests may involve ordinary request information and information you send us."]}]]]}],["$","section","local",{"id":"local","className":"reserved-section","children":[["$","h2",null,{"children":"2. Local Storage and Optional Cloud Backup"}],[["$","p",null,{"children":"Supported fitness, nutrition, habit and progress records are saved first in an account-specific SQLite database on your device. Guest records are separate. A downloaded food catalog and some shared settings are outside that account database."}],["$","p",null,{"children":["Choosing ",["$","strong",null,{"children":"Back up my data"}]," synchronizes supported records to Convex under your authenticated identity. Choosing ",["$","strong",null,{"children":"Keep it on this device"}]," pauses fitness-data synchronization; it does not delete an existing cloud copy. Pending changes and unresolved conflicts may remain locally. The backup setting does not turn off authentication, subscription checks, diagnostics, advertising processing or security operations."]}],"$L23"]]}],"$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e"],"$L2f"]}]
12:["$","footer",null,{"className":"site-footer","children":["$","div",null,{"className":"container footer-row","children":[["$","span",null,{"children":"© Cubyfit. Support and legal information."}],["$","nav",null,{"className":"footer-links","aria-label":"Footer navigation","children":[["$","$La",null,{"href":"/privacy","children":"Privacy"}],["$","$La",null,{"href":"/terms","children":"Terms"}],["$","$La",null,{"href":"/delete-account","children":"Account deletion"}],["$","$La",null,{"href":"/contact","children":"Contact"}]]}]]}]}]
