23:["$","p",null,{"children":"Device transfers and operating-system backups may copy local files separately. Cubyfit does not add application-level SQLCipher encryption to the SQLite database."}]
24:["$","section","purposes",{"id":"purposes","className":"reserved-section","children":[["$","h2",null,{"children":"3. How We Use Information"}],[["$","p",null,{"children":"We use information to manage accounts; provide fitness, nutrition, workout, habit and progress features; save settings and optional cloud backups; calculate requested estimates; manage entitlements; deliver reminders; maintain service reliability and security; show ads to eligible free users subject to applicable choices; respond to support and deletion requests; and meet applicable legal obligations."}],["$","p",null,{"children":["We do not intend to retain identifiable fitness statistics solely for our own business analytics after account deletion. We do not sell personal fitness records as a customer-data product. ",["$","strong",null,{"children":"Before publication:"}]," Map actual internal analytics, processing purposes and legal bases for each relevant jurisdiction."]}]]]}]
25:["$","section","advertising",{"id":"advertising","className":"reserved-section","children":[["$","h2",null,{"children":"4. Advertising and Privacy Choices"}],[["$","p",null,{"children":"The Android app may show Google AdMob ads to eligible free users. Ad providers may process device and advertising identifiers, IP address, ad interactions and related technical information. Google UMP presents advertising privacy choices where configured and required. The applicable choices vary by region and provider."}],["$","p",null,{"children":"The app checks UMP permission before loading an interstitial. Declining optional advertising consent does not disable core tracking features or unrelated services. We do not intentionally send individual nutrition logs, measurements or habit records to ad providers for targeting. Cubyfit Pro is intended to be ad-free while eligible entitlement is active."}],["$","p",null,{"children":[["$","strong",null,{"children":"Before publication:"}]," Add and verify an ordinary in-app privacy-options entry point and regional messages. The current privacy-options form is reachable only through an internal testing screen."]}]]]}]
26:["$","section","providers",{"id":"providers","className":"reserved-section","children":[["$","h2",null,{"children":"5. Service Providers"}],[["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Clerk:"}]," Authentication, identity and sessions."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Convex:"}]," Authenticated operations and optional cloud backup."]}],["$","li",null,{"children":[["$","strong",null,{"children":"RevenueCat and Google Play or Apple:"}]," Entitlements, purchases and billing."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Google AdMob and UMP:"}]," Advertising and advertising choices."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Sentry:"}]," Error reports and reliability diagnostics."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Cloudflare:"}]," Protected food-catalog delivery and access controls."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Vercel:"}]," Website hosting."]}]]}],["$","p",null,{"children":"Providers may process information under their own policies and retention rules. The protected food-catalog gateway receives authenticated account information and source IP for access controls; its downloaded catalog is separate from your personal diary."}]]]}]
27:["$","section","transfers",{"id":"transfers","className":"reserved-section","children":[["$","h2",null,{"children":"6. International Processing"}],["$","p",null,{"children":["Service providers may process information outside your country. Locations and safeguards depend on their configurations and the laws applicable to users. ",["$","strong",null,{"children":"Before publication:"}]," Complete a professional review of Moroccan Law 09-08, CNDP obligations, relevant international transfers, GDPR and any other launch-market requirements. Specify the applicable mechanisms and controller details."]}]]}]
28:["$","section","retention",{"id":"retention","className":"reserved-section","children":[["$","h2",null,{"children":"7. Data Retention"}],[["$","p",null,{"children":"Account and app records are kept while needed to provide the service, until deletion or an applicable retention obligation. Local records stay on a device until removed through app or device operations; pausing cloud backup does not erase existing Convex records."}],["$","p",null,{"children":["After a verified account-deletion request, the backend blocks private cloud operations and deletes supported account-owned Convex records, then requests deletion of the matching RevenueCat customer and Clerk identity. Failures may cause retries and delay completion. A limited deletion-status job containing account identifiers, receipt, stage and timestamps remains about 30 days ",["$","strong",null,{"children":"after completion"}],"; incomplete jobs remain until resolved."]}],["$","p",null,{"children":"The device observing completion removes its matching account SQLite database. Offline devices cannot be erased remotely. If a device reconnects after the status record expires, automatic cleanup may no longer occur; its app data may require manual clearing. Guest data, shared catalog files, operating-system backups, store transactions and provider records are outside this cleanup. Sentry, advertising, Cloudflare and provider backups may have separate retention periods that must be verified before publication."}]]]}]
29:["$","section","deletion",{"id":"deletion","className":"reserved-section","children":[["$","h2",null,{"children":"8. Account Deletion"}],[["$","p",null,{"children":["In the signed-in app, go to ",["$","strong",null,{"children":"Account → Data & Privacy → Delete Account"}],". Enter ",["$","code",null,{"children":"DELETE-ACCOUNT"}],", complete Clerk email-code reverification and submit. The app shows available progress while the backend processes deletion. On completion it removes supported account-owned active cloud records and requests deletion of the corresponding Clerk and RevenueCat customer records, subject to the limits above."]}],["$","p",null,{"children":["Deleting your Cubyfit account does not cancel an active Google Play or App Store subscription. See the ",["$","a",null,{"href":"/delete-account","children":"deletion page"}],". Its outside-app request channel must be established before these pages are published."]}]]]}]
2a:["$","section","rights",{"id":"rights","className":"reserved-section","children":[["$","h2",null,{"children":"9. Your Privacy Rights"}],["$","p",null,{"children":["Depending on applicable law, you may request access, correction or deletion; object to or restrict processing; withdraw consent where applicable; ask about transfers; or exercise other applicable rights. Contact ",["$","strong",null,{"children":"[VERIFIED PRIVACY EMAIL PENDING]"}],". We may verify your identity before handling account-related requests. You may also contact a relevant data-protection authority."]}]]}]
2b:["$","section","security",{"id":"security","className":"reserved-section","children":[["$","h2",null,{"children":"10. Security"}],["$","p",null,{"children":"Cubyfit uses authenticated backend access, account-specific storage, cloud access controls and encrypted service connections where applicable. Supported secure storage holds authentication tokens and deletion receipts. Its fitness SQLite file is not separately encrypted at the application level. No electronic service can be guaranteed completely secure. Report suspected unauthorized access through the verified privacy contact once established."}]]}]
2c:["$","section","children",{"id":"children","className":"reserved-section","children":[["$","h2",null,{"children":"11. Children and Age Eligibility"}],["$","p",null,{"children":[["$","strong",null,{"children":"Before publication:"}]," Finalize the minimum age, age screening, applicable parental consent and minor-specific SDK and advertising treatment. The founders' proposed 13+ worldwide audience is not yet an implemented eligibility rule."]}]]}]
2d:["$","section","changes",{"id":"changes","className":"reserved-section","children":[["$","h2",null,{"children":"12. Changes"}],["$","p",null,{"children":"We may update this policy when the service or legal requirements change. The published version will show its effective date; where required, we will provide additional notice or request consent."}]]}]
