24:[["$","p",null,{"children":["Cubyfit may offer monthly and annual subscriptions. The intended standard pricing is USD $5.99 monthly and USD $59.99 annually. Eligible annual subscriptions may include a 14-day trial. ",["$","strong",null,{"children":"These are intended offers, not a promise of the same currency, price, promotion or trial for every user."}]," The actual store checkout shows the applicable price, billing period, available trial and taxes."]}],["$","p",null,{"children":["Pro benefits are those displayed in the app and relevant subscription offer. RevenueCat and the applicable store manage entitlement status. ",["$","strong",null,{"children":"Before publication:"}]," Verify the actual products, trial eligibility, displayed benefits and prices in each store."]}]]
25:["$","section","billing",{"id":"billing","className":"reserved-section","children":[["$","h2",null,{"children":"7. Trials, Renewals and Cancellation"}],[["$","p",null,{"children":"Subscriptions may renew automatically unless cancelled through the relevant app store. If a free trial is offered and you qualify, it may become paid at the end of the trial unless you cancel within the required period. Review the checkout terms."}],["$","p",null,{"children":["Manage subscriptions through ",["$","a",null,{"href":"https://play.google.com/store/account/subscriptions","children":"Google Play"}]," or ",["$","a",null,{"href":"https://apps.apple.com/account/subscriptions","children":"Apple"}],". Uninstalling Cubyfit or deleting your account does not automatically cancel billing. Refund requests follow applicable store rules and mandatory consumer-protection law."]}]]]}]
26:["$","section","ads",{"id":"ads","className":"reserved-section","children":[["$","h2",null,{"children":"8. Advertising"}],["$","p",null,{"children":["Free accounts may display Google AdMob advertisements. Eligible Cubyfit Pro accounts are intended to receive an ad-free experience while the entitlement is active. Advertising practices and privacy choices are described in the ",["$","a",null,{"href":"/privacy","children":"Privacy Policy"}],"."]}]]}]
27:["$","section","backup",{"id":"backup","className":"reserved-section","children":[["$","h2",null,{"children":"9. Local Data and Cloud Backup"}],["$","p",null,{"children":"Cubyfit saves supported fitness information locally and offers optional cloud backup. Synchronization and restoration depend on connectivity, authentication, service availability and supported synchronization behavior. Not every local change can be guaranteed recoverable, particularly during unresolved conflicts, device loss or interrupted synchronization."}]]}]
28:["$","section","ip",{"id":"ip","className":"reserved-section","children":[["$","h2",null,{"children":"10. Intellectual Property"}],["$","p",null,{"children":"Cubyfit's original software, interface, branding and content remain the property of their respective rights holders. Third-party materials remain subject to their own licenses and attribution requirements. Using the service does not grant ownership of Cubyfit's intellectual property."}]]}]
29:["$","section","deletion",{"id":"deletion","className":"reserved-section","children":[["$","h2",null,{"children":"11. Account Deletion"}],["$","p",null,{"children":["You can request irreversible account deletion through the app. The process removes supported account-owned records from Cubyfit's active systems, subject to the technical and legal retention limitations in the ",["$","a",null,{"href":"/privacy","children":"Privacy Policy"}],". Active store subscriptions must be cancelled separately. See the ",["$","a",null,{"href":"/delete-account","children":"account-deletion page"}]," for details. The outside-app request channel on that page is pending verification."]}]]}]
