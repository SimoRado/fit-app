2b:["$","section","liability",{"id":"liability","className":"reserved-section","children":[["$","h2",null,{"children":"13. Liability"}],["$","p",null,{"children":"We make reasonable efforts to provide useful and reliable functionality. To the extent permitted by law, Cubyfit is not responsible for fitness outcomes or inaccuracies caused by user-entered information or third-party reference data. Nothing in these Terms excludes mandatory consumer rights or liability that cannot lawfully be excluded."}]]}]
