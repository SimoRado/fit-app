{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "CUBYFIT_ADMOB_BUILD_CHANNEL": "eas-internal",
        "EXPO_PUBLIC_CUBYFIT_ADMOB_TESTING": "true",
