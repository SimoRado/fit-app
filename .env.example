# Public deployment URL only. Select the existing Convex development project first.
EXPO_PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_development_publishable_key
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_your_public_test_store_key
EXPO_PUBLIC_SENTRY_DSN=https://public_key@your-sentry-host.example/project_id
# Build environment only: set SENTRY_ORG, SENTRY_PROJECT, and sensitive SENTRY_AUTH_TOKEN in EAS.
# Set after verifying the exact entitlement identifier in RevenueCat.
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=your_entitlement_identifier

# Sentry
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
