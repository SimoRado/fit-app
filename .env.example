# Public deployment URL only. Select the existing Convex development project first.
EXPO_PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_development_publishable_key
# Enable only after the matching Apple connection/app is enabled in the Clerk development instance.
EXPO_PUBLIC_CLERK_APPLE_ANDROID_OAUTH_ENABLED=false
EXPO_PUBLIC_CLERK_APPLE_IOS_NATIVE_ENABLED=false
# Local Android APK script and internal EAS profiles set this to true at build time.
# Keep it false or unset for production and release updates.
EXPO_PUBLIC_CUBYFIT_ADMOB_TESTING=false
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_your_public_test_store_key
EXPO_PUBLIC_SENTRY_DSN=https://public_key@your-sentry-host.example/project_id
# Full-catalog downloads require the authenticated Cloudflare Catalog Gateway.
# There is no direct R2 URL fallback. Never put R2 upload credentials in EXPO_PUBLIC variables.
# EXPO_PUBLIC_CATALOG_GATEWAY_URL=https://cubyfit-catalog-gateway.<account>.workers.dev
# Build environment only: set SENTRY_ORG, SENTRY_PROJECT, and sensitive SENTRY_AUTH_TOKEN in EAS.
# Set after verifying the exact entitlement identifier in RevenueCat.
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=your_entitlement_identifier
# Production release only, from the existing RevenueCat project. Without a
# platform key, entitlement status stays unresolved and interstitials stay off.
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your_android_public_sdk_key
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your_ios_public_sdk_key

# Local and EAS build environment. The App ID uses ~ and the unit ID uses /.
# Store real identifiers in ignored .env.local or the EAS environment, not Git.
GOOGLE_ADMOB_APP_ID=
GOOGLE_ADMOB_AD_UNIT_ID=
# Internal previews leave both switches off. A release requires a working
# production RevenueCat entitlement source before either switch is enabled.
EXPO_PUBLIC_ADMOB_PRODUCTION_ADS_ENABLED=false
# CUBYFIT_ADMOB_BUILD_CHANNEL=production

# Sentry
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
